<!-- some examples of how to customize the build. -->
<!-- (If you delete it and reopen the project it will be recreated.) -->
<!-- By default, only the Clean and Build commands use this build script. -->
<!-- Commands such as Run, Debug, and Test only use this build script if -->
<!-- the Compile on Save feature is turned off for the project. -->
<!-- You can turn off the Compile on Save (or Deploy on Save) setting -->
<!-- in the project's Project Properties dialog box.-->
<project name="LituyaBay1958" default="default" basedir=".">
    <description>Builds, tests, and runs the project LituyaBay1958.</description>
    <import file="nbproject/build-impl.xml"/>
    <!--

    There exist several targets which are by default empty and which can be 
    used for execution of your tasks. These targets are usually executed 
    before and after some main targets. They are: 

      -pre-init:                 called before initialization of project properties
      -post-init:                called after initialization of project properties
      -pre-compile:              called before javac compilation
      -post-compile:             called after javac compilation
      -pre-compile-single:       called before javac compilation of single file
      -post-compile-single:      called after javac compilation of single file
      -pre-compile-test:         called before javac compilation of JUnit tests
      -post-compile-test:        called after javac compilation of JUnit tests
      -pre-compile-test-single:  called before javac compilation of single JUnit test
      -post-compile-test-single: called after javac compilation of single JUunit test
      -pre-jar:                  called before JAR building
      -post-jar:                 called after JAR building
      -post-clean:               called after cleaning build products

    (Targets beginning with '-' are not intended to be called on their own.)

    Example of inserting an obfuscator after compilation could look like this:

        <target name="-post-compile">
            <obfuscate>
                <fileset dir="${build.classes.dir}"/>
            </obfuscate>
        </target>

    For list of available properties check the imported 
    nbproject/build-impl.xml file. 


    Another way to customize the build is by overriding existing main targets.
    The targets of interest are: 

      -init-macrodef-javac:     defines macro for javac compilation
      -init-macrodef-junit:     defines macro for junit execution
      -init-macrodef-debug:     defines macro for class debugging
      -init-macrodef-java:      defines macro for class execution
      -do-jar:                  JAR building
      run:                      execution of project 
      -javadoc-build:           Javadoc generation
      test-report:              JUnit report generation

    An example of overriding the target for project execution could look like this:

        <target name="run" depends="LituyaBay1958-impl.jar">
            <exec dir="bin" executable="launcher.exe">
                <arg file="${dist.jar}"/>
            </exec>
        </target>

    Notice that the overridden target depends on the jar target and not only on 
    the compile target as the regular run target does. Again, for a list of available 
    properties which you can use, check the target you are overriding in the
    nbproject/build-impl.xml file. 

    -->
    <!--
        Phase 1 (aus Sylt und Timmendorf): Prüfung von lib/Renderer.jar. Die Element-Packages liegen nicht im Projekt: ihre
        Quelle ist das Projekt Renderer (Werkbuch 4.1). Hier prüft tools/JarPruefung.java nach jedem Übersetzen, ob
        lib/Renderer.jar alles hat, was LituyaBay1958 braucht (jedes gebrauchte Package mit Klassen und README, Java 21,
        von den 14 neuen die, deren Phase erreicht ist); abschalten mit -Dohne.paketpruefung=true.
    -->
    <property name="lituya.phase" value="7"/>
    <target name="check-packages" description="Prüft lib/Renderer.jar: die gebrauchten Packages mit README, Java 21, die fälligen neuen." unless="ohne.paketpruefung">
        <property name="platform.java" value="java"/>
        <exec executable="${platform.java}" dir="${basedir}" failonerror="true">
            <arg value="-Dstdout.encoding=UTF-8"/>
            <arg value="-Dstderr.encoding=UTF-8"/>
            <arg value="tools/JarPruefung.java"/>
            <arg value="lib/Renderer.jar"/>
            <arg value="${lituya.phase}"/>
        </exec>
    </target>
    <target name="-post-compile" depends="check-packages"/>
    <!-- Phase 1: Prüfprogramm der App ohne Grafikkarte und Datenbank (endet mit "ERGEBNIS: alles in Ordnung"). -->
    <target name="pruefung" depends="compile-test" description="Startet die Prüfung com.dan.lituya.test.Pruefung.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.lituya.test.Pruefung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx2g"/>
            <classpath><pathelement path="${run.test.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 1: das Statusbild auf der Grafikkarte: docs/status/Status_Phase1.png (Grundansicht, 9.7.1958 22:00 PST,
         Stufe Mittel, Full HD, volles HUD mit den Zeiten jedes Durchgangs). Auf der Radeon laufen lassen; die Zeiten
         stehen auch in der Ausgabe. -Dansicht=Name wählt eine der neun Ansichten (etwa -Dansicht=AnchorageCove),
         -Dbild=… einen anderen Dateinamen. -->
    <target name="statusbild" depends="jar" description="docs/status/Status_Phase${lituya.phase}.png (Grundansicht, volles HUD; seit Phase 4 mit Gelände).">
        <property name="platform.java" value="java"/>
        <property name="ansicht" value=""/>
        <property name="bild" value="docs/status/Status_Phase${lituya.phase}.png"/>
        <java classname="com.dan.lituya.tools.Tempo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx4g"/>
            <jvmarg value="-Dhud=voll"/>
            <jvmarg value="-Dansicht=${ansicht}"/>
            <arg line="120 1920 1080 ${bild} MITTEL 22 1958-07-09"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 1 (F26 A, wie Timmendorf): den JDBC-Treiber 21 für LOD aus ORACLE_HOME\jdbc\lib nach lib/lod/ holen und im
         eigenen Klassenlader mit sdonm.jar probieren. Ohne ORACLE_HOME: ant lod -Dtreiber=C:\…\jdbc\lib\ojdbc11.jar -->
    <target name="lod" depends="compile" description="Phase 1: Treiber 21 nach lib/lod holen und LOD im eigenen Klassenlader probieren.">
        <property name="platform.java" value="java"/>
        <property name="treiber" value=""/>
        <java classname="com.dan.lituya.netz.Lod" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <arg value="${treiber}"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 2 (Werkbuch 3.3, 3.4): die Aufbereitung liest das Kartenmaterial (Pfad in daten/rohdaten.properties, Vorgabe
         download/) einmal und schreibt nach daten/. ant aufbereitung rechnet alle Schritte (gelaende, grund, namen, texturen,
         herkunft, bilder, inhalt); -Dschritte=gelaende,grund nur diese; -Dneu=true rechnet fertige Kacheln neu; -Dausschnitt=OstMin,NordMin,OstMax,NordMax
         nur die Kacheln dort; -Dfaeden=n. Prüfbilder nach docs/status/, Protokoll daten/aufbereitung.log. -->
    <target name="aufbereitung" depends="compile" description="Phase 2: Kartenmaterial einmal nach daten/ aufbereiten (Gelände, Grund, Namen, Prüfbilder, INHALT.txt).">
        <property name="platform.java" value="java"/>
        <property name="schritte" value=""/>
        <property name="neu" value="false"/>
        <property name="ausschnitt" value=""/>
        <property name="faeden" value="0"/>
        <java classname="com.dan.lituya.tools.Aufbereitung" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <jvmarg value="-Xmx24g"/>
            <jvmarg value="-Dneu=${neu}"/>
            <jvmarg value="-Dlituya.ausschnitt=${ausschnitt}"/>
            <jvmarg value="-Dlituya.cache.mb=4000"/>
            <arg value="${schritte}"/>
            <syspropertyset><propertyref name="faeden"/></syspropertyset>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 3 (Werkbuch 2.8, 7.7, 7.9): Schema LITUYABAY1958 neu aufbauen (db/netz/99, 01, 02), LB_NET_HERKUNFT aus
         daten/netz/herkunft laden, NDM-Funktionsprobe (03_probe.sql und Java/LOD im eigenen Lader), Probenetze weg (98),
         Partitionen und Sichten (04, 05), VALIDATE_NETWORK, Gegenrechnung (CONNECT BY und traceIn gegen pruefwege.tsv),
         LB_NETZ_STAND. Vorher einmal als SYS: db/netz/00_sys.sql. Protokoll docs/status/netzdb_Phase3.txt. -->
    <target name="netzdb" depends="compile" description="Phase 3: Netze nach Oracle laden, NDM-Funktionsprobe, Gegenrechnung.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.lituya.tools.NetzDb" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg value="laden"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 3: nur prüfen, ob Oracle und daten/netz zusammenpassen (Prüfsumme, Zahlen, VALIDATE_NETWORK, LB_NDM_PROBE). -->
    <target name="dbpruefung" depends="compile" description="Phase 3: prüfen, ob die Netze in Oracle zu daten/netz passen.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.lituya.tools.NetzDb" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Djava.awt.headless=true"/>
            <arg value="pruefen"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 4 (Werkbuch 5.11): das Package com.dan.clipmap aus lib/Renderer.jar über daten/gelaende (Ursprung E 352 000,
         N 6 503 000). clipmapcheck: ClipmapCheck mit 1 000 Stichproben an den Kacheln und dem Baustein auf der Grafikkarte
         gegen Java (Ausgabe auch nach docs/status/clipmapcheck_Phase4.txt); clipmapdemo: die Vorschau des Packages, Auge in
         der Bucht vor dem Gilbert Inlet; clipmapbild: vier Ansichten mit der Zeit je Bild nach docs/status/Phase4_Clipmap.png. -->
    <target name="clipmapcheck" depends="compile" description="Phase 4: ClipmapCheck über daten/gelaende, mit Grafikkarte.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.clipmap.demo.ClipmapCheck" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true" output="docs/status/clipmapcheck_Phase4.txt" logError="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx4g"/>
            <arg line="--gpu --daten daten/gelaende 352000 6503000"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
        <loadfile property="clipmapcheck.text" srcFile="docs/status/clipmapcheck_Phase4.txt" encoding="UTF-8"/>
        <echo message="${clipmapcheck.text}"/>
    </target>
    <target name="clipmapdemo" depends="compile" description="Phase 4: die Vorschau von com.dan.clipmap über daten/gelaende.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.clipmap.demo.ClipmapDemo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg line="--add-opens java.desktop/sun.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.windows=ALL-UNNAMED --add-opens java.desktop/sun.java2d=ALL-UNNAMED"/>
            <jvmarg value="-Xmx4g"/>
            <arg line="--daten daten/gelaende 352000 6503000 --auge 2300 -1900 60 30"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <target name="clipmapbild" depends="compile" description="Phase 4: vier Ansichten der Clipmap mit der Zeit je Bild nach docs/status/Phase4_Clipmap.png.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.clipmap.demo.ClipmapDemo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx4g"/>
            <arg line="--daten daten/gelaende 352000 6503000 --auge 2300 -1900 60 30 --bild docs/status/Phase4_Clipmap.png"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 5 (Werkbuch 5.10, 8): das Package com.dan.surface aus lib/Renderer.jar. Ablauf: python tools/kartenmaterial/
         kartenmaterial.py laden, Gruppe texturen (13 CC0-Sätze von ambientCG nach download/texturen), dann
         ant aufbereitung "-Dschritte=texturen,herkunft,inhalt" (gebacken nach daten/texturen). surfacecheck: SurfaceCheck mit
         dem echten Strandkies (1 km ohne Wiederholung); texturbild: Kontaktbogen docs/status/Texturen.png (beim ersten Mal
         packt der Treiber die Karten, das dauert); surfacedemo: die Vorschau mit Reglern. -->
    <target name="surfacecheck" depends="compile" description="Phase 5: SurfaceCheck mit daten/texturen.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.surface.demo.SurfaceCheck" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true" output="docs/status/surfacecheck_Phase${lituya.phase}.txt" logError="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="-Xmx4g"/>
            <arg line="--texturen daten/texturen"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
        <loadfile property="surfacecheck.text" srcFile="docs/status/surfacecheck_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${surfacecheck.text}"/>
    </target>
    <target name="texturbild" depends="compile" description="Phase 5: Kontaktbogen der Materialien nach docs/status/Texturen.png.">
        <property name="platform.java" value="java"/>
        <property name="kante" value="1024"/>
        <java classname="com.dan.surface.demo.SurfaceDemo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <arg line="--texturen daten/texturen --kante ${kante} --bild docs/status/Texturen.png"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <target name="surfacedemo" depends="compile" description="Phase 5: die Vorschau von com.dan.surface über daten/texturen.">
        <property name="platform.java" value="java"/>
        <java classname="com.dan.surface.demo.SurfaceDemo" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
            <jvmarg value="-Dstdout.encoding=UTF-8"/>
            <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
            <jvmarg line="--add-opens java.desktop/sun.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.windows=ALL-UNNAMED --add-opens java.desktop/sun.java2d=ALL-UNNAMED"/>
            <jvmarg value="-Xmx6g"/>
            <arg line="--texturen daten/texturen"/>
            <classpath><pathelement path="${run.classpath}"/></classpath>
        </java>
    </target>
    <!-- Phase 6 (Werkbuch 6.4, 5.7): com.dan.forest mit ForestGpu (Kultur auf der Grafikkarte, Oktaeder-Impostors, Zustand je
         Baum, Sitka-Fichte und Hemlocktanne) und das neue Package com.dan.understory, beide aus lib/Renderer.jar.
         waldcheck: ForestCheck (ohne Grafikkarte) und ForestGpuCheck (Grafikkarte = Prozessor) nach docs/status/waldcheck_Phase6.txt;
         waldbild: vier Ansichten der gerechneten Bucht nach docs/status/Wald.png (-Dqualitaet=HIGH); waldzeiten: die fps-Tabelle je
         Qualität und Ansicht nach docs/status/waldzeiten_Phase6.txt; walddemo: Fenster. waldvergleich: Paketvertrag 14, die Wälder
         der anderen Szenen unverändert (vorher das alte Jar als lib/Renderer_phase5.jar sichern). unterwuchscheck,
         unterwuchsbild (docs/status/Unterwuchs.png), unterwuchsdemo. -->
    <macrodef name="renderer-java">
        <attribute name="klasse"/>
        <attribute name="args" default=""/>
        <attribute name="ausgabe"/>
        <attribute name="speicher" default="-Xmx6g"/>
        <sequential>
            <property name="platform.java" value="java"/>
            <java classname="@{klasse}" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true" output="@{ausgabe}" logError="true">
                <jvmarg value="-Dstdout.encoding=UTF-8"/>
                <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
                <jvmarg line="--add-opens java.desktop/sun.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.windows=ALL-UNNAMED --add-opens java.desktop/sun.java2d=ALL-UNNAMED"/>
                <jvmarg value="@{speicher}"/>
                <arg line="@{args}"/>
                <!-- Renderer.jar zuerst: FStyle.jar bringt ältere Kopien von com.dan.forest, ground, river und road mit -->
                <classpath><pathelement location="lib/Renderer.jar"/><pathelement path="${run.classpath}"/></classpath>
            </java>
        </sequential>
    </macrodef>
    <macrodef name="renderer-fenster">
        <attribute name="klasse"/>
        <attribute name="speicher" default="-Xmx6g"/>
        <sequential>
            <property name="platform.java" value="java"/>
            <java classname="@{klasse}" fork="true" jvm="${platform.java}" dir="${basedir}" failonerror="true">
                <jvmarg value="-Dstdout.encoding=UTF-8"/>
                <jvmarg value="--enable-native-access=ALL-UNNAMED"/>
                <jvmarg line="--add-opens java.desktop/sun.awt=ALL-UNNAMED --add-opens java.desktop/sun.awt.windows=ALL-UNNAMED --add-opens java.desktop/sun.java2d=ALL-UNNAMED"/>
                <jvmarg value="@{speicher}"/>
                <!-- Renderer.jar zuerst: FStyle.jar bringt ältere Kopien von com.dan.forest, ground, river und road mit -->
                <classpath><pathelement location="lib/Renderer.jar"/><pathelement path="${run.classpath}"/></classpath>
            </java>
        </sequential>
    </macrodef>
    <target name="waldcheck" depends="compile" description="Phase 6: ForestCheck und ForestGpuCheck nach docs/status/waldcheck_Phase6.txt.">
        <renderer-java klasse="com.dan.forest.demo.ForestCheck" ausgabe="docs/status/waldcheck_Phase${lituya.phase}.txt"/>
        <renderer-java klasse="com.dan.forest.demo.ForestGpuCheck" ausgabe="docs/status/waldcheck_gpu_Phase${lituya.phase}.txt"/>
        <concat destfile="docs/status/waldcheck_Phase${lituya.phase}.txt" append="true" encoding="UTF-8" outputencoding="UTF-8">
            <header>&#10;--- ForestGpuCheck (Grafikkarte)&#10;</header>
            <fileset file="docs/status/waldcheck_gpu_Phase${lituya.phase}.txt"/>
        </concat>
        <delete file="docs/status/waldcheck_gpu_Phase${lituya.phase}.txt"/>
        <loadfile property="waldcheck.text" srcFile="docs/status/waldcheck_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${waldcheck.text}"/>
    </target>
    <target name="waldbild" depends="compile" description="Phase 6: vier Ansichten der gerechneten Bucht nach docs/status/Wald.png.">
        <property name="qualitaet" value="HIGH"/>
        <renderer-java klasse="com.dan.forest.demo.ForestGpuDemo" args="--bild docs/status/Wald.png ${qualitaet}" ausgabe="docs/status/waldbild_Phase${lituya.phase}.txt"/>
        <loadfile property="waldbild.text" srcFile="docs/status/waldbild_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${waldbild.text}"/>
    </target>
    <target name="waldzeiten" depends="compile" description="Phase 6: fps-Tabelle des Walds nach docs/status/waldzeiten_Phase6.txt.">
        <renderer-java klasse="com.dan.forest.demo.ForestGpuDemo" args="--zeiten" ausgabe="docs/status/waldzeiten_Phase${lituya.phase}.txt"/>
        <loadfile property="waldzeiten.text" srcFile="docs/status/waldzeiten_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${waldzeiten.text}"/>
    </target>
    <target name="walddemo" depends="compile" description="Phase 6: ForestGpuDemo im Fenster.">
        <renderer-fenster klasse="com.dan.forest.demo.ForestGpuDemo"/>
    </target>
    <target name="waldvergleich" description="Phase 6: die Wälder der anderen Szenen unverändert (lib/Renderer_phase5.jar gegen lib/Renderer.jar).">
        <property name="platform.java" value="java"/>
        <property name="alt" value="lib/Renderer_phase5.jar"/>
        <exec executable="${platform.java}" dir="${basedir}" failonerror="true" output="docs/status/waldvergleich_Phase${lituya.phase}.txt">
            <arg value="-Dstdout.encoding=UTF-8"/>
            <arg value="tools/WaldVergleich.java"/>
            <arg value="${alt}"/>
            <arg value="lib/Renderer.jar"/>
        </exec>
        <loadfile property="waldvergleich.text" srcFile="docs/status/waldvergleich_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${waldvergleich.text}"/>
    </target>
    <target name="unterwuchscheck" depends="compile" description="Phase 6: UnderstoryCheck nach docs/status/unterwuchscheck_Phase6.txt.">
        <renderer-java klasse="com.dan.understory.demo.UnderstoryCheck" ausgabe="docs/status/unterwuchscheck_Phase${lituya.phase}.txt" speicher="-Xmx2g"/>
        <loadfile property="unterwuchscheck.text" srcFile="docs/status/unterwuchscheck_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${unterwuchscheck.text}"/>
    </target>
    <target name="unterwuchsbild" depends="compile" description="Phase 6: die sieben Arten und der Waldboden nach docs/status/Unterwuchs.png.">
        <renderer-java klasse="com.dan.understory.demo.UnderstoryDemo" args="--bild docs/status/Unterwuchs.png" ausgabe="docs/status/unterwuchsbild_Phase${lituya.phase}.txt" speicher="-Xmx2g"/>
        <loadfile property="unterwuchsbild.text" srcFile="docs/status/unterwuchsbild_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${unterwuchsbild.text}"/>
    </target>
    <target name="unterwuchsdemo" depends="compile" description="Phase 6: UnderstoryDemo im Fenster.">
        <renderer-fenster klasse="com.dan.understory.demo.UnderstoryDemo" speicher="-Xmx2g"/>
    </target>
    <!-- Phase 7 (Werkbuch 6.9, 5.12): com.dan.route mit TravelGrid (Laufzeitgitter 4/8/16/32 Nachbarn, Isochronen, Messstrecke)
         und das neue Package com.dan.netview, beide aus lib/Renderer.jar. routecheck: RouteCheck (Gitterfehler 2,75 % / 0,75 %,
         T = L/√(g h) auf konstantem Grund) nach docs/status/routecheck_Phase7.txt; isochronendemo: gerechnete Fjordbucht nach
         docs/status/Isochronen_Demo.png (Fenster: -Dfenster=ja); isochronenbild: die Front über dem echten Grund heute und 1940,
         linear und nichtlinear, nach docs/status/Isochronen.png mit Ankunftszeiten; netviewcheck, netviewbild
         (docs/status/Netzblick.png), netviewdemo. -->
    <target name="routecheck" depends="compile" description="Phase 7: RouteCheck nach docs/status/routecheck_Phase7.txt.">
        <renderer-java klasse="com.dan.route.demo.RouteCheck" ausgabe="docs/status/routecheck_Phase${lituya.phase}.txt" speicher="-Xmx2g"/>
        <loadfile property="routecheck.text" srcFile="docs/status/routecheck_Phase${lituya.phase}.txt" encoding="UTF-8"/>
        <echo message="${routecheck.text}"/>
    </target>
    <target name="isochronendemo" depends="compile" description="Phase 7: IsochroneDemo (gerechnete Bucht) nach docs/status/Isochronen_Demo.png.">
        <renderer-java klasse="com.dan.route.demo.IsochroneDemo" args="--bild docs/status/Isochronen_Demo.png" ausgabe="docs/status/isochronendemo_Phase${lituya.phase}.txt" speicher="-Xmx2g"/>
