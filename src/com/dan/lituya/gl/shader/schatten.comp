// schatten.comp — Werkbuch Welle W1 (L2): Horizontkarte. Je Bodenpunkt des Zielgitters der höchste Winkel des Geländes
// in Richtung des Sonnen-Azimuts (Radiant über der Waagerechten), mit Erdkrümmung und Strahlenbrechung (wirksamer
// Erdradius uR), und mindestens die Kimm des Meers aus der Höhe des Punkts. Höhen aus zwei Gittern: fein über den Kern,
// grob über die Szene, dahinter Meer. Ausgabe: r = Horizontwinkel, g = Höhe des Bodens (m über NAVD88).
// Ob ein Punkt Sonne hat, entscheidet common.glsl aus der Sonnenhöhe; die Karte gilt für jede Sonnenhöhe bei diesem Azimut.
layout(local_size_x = 16, local_size_y = 16) in;
layout(rg32f, binding = 0) writeonly uniform image2D uOut;
uniform sampler2D uHoeheF, uHoeheG;
uniform vec4 uFein, uGrob;   // x0, z0, Kante
uniform vec4 uZiel;          // x0, z0, Kante, Zellen je Kante
uniform vec2 uDir;           // waagerechte Richtung zur Sonne (x, z)
uniform float uR;

float hoehe(vec2 p) {
    vec2 uf = (p - uFein.xy) / uFein.z;
    if (all(greaterThanEqual(uf, vec2(0.0))) && all(lessThanEqual(uf, vec2(1.0)))) return textureLod(uHoeheF, uf, 0.0).r;
    vec2 ug = (p - uGrob.xy) / uGrob.z;
    if (all(greaterThanEqual(ug, vec2(0.0))) && all(lessThanEqual(ug, vec2(1.0)))) return textureLod(uHoeheG, ug, 0.0).r;
    return 0.0;
}

void main() {
    ivec2 ij = ivec2(gl_GlobalInvocationID.xy);
    int n = int(uZiel.w);
    if (ij.x >= n || ij.y >= n) return;
    float c = uZiel.z / uZiel.w;
    vec2 p = uZiel.xy + (vec2(ij) + 0.5) * c;
    float h0 = hoehe(p);
    // Kimm des Meers aus der Höhe h0 (Winkel unter der Waagerechten)
    float best = -sqrt(2.0 * max(h0, 0.0) / uR);
    float d = c * 0.75, maxD = 90000.0;
    for (int k = 0; k < 420 && d < maxD; k++) {
        float h = hoehe(p + uDir * d);
        float a = (h - h0 - d * d / (2.0 * uR)) / d;
        best = max(best, a);
        d += max(c * 0.75, d * 0.022);
    }
    imageStore(uOut, ij, vec4(atan(best), h0, 0.0, 0.0));
}
